<!--
  Google Material Symbols "home_storage" (filled), the icon the Idea Log's
  archive view shows to return to the active list.

  It is bundled here rather than taken from androidx material-icons-extended:
  that library is generated from the older Material Icons set, which has no
  home_storage — the glyph exists only in Material Symbols.

  Traced verbatim from the Material Symbols source, whose viewBox is
  "0 -960 960 960"; a VectorDrawable viewport always starts at 0,0, so the
  group's translateY shifts the path down into it rather than the path being
  redrawn by hand. Icon() tints it with the current content color, so the
  fillColor here is only a placeholder.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="960"
    android:viewportHeight="960"
    android:tint="#FF000000">
    <group android:translateY="960">
